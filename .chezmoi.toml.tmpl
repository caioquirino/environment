{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email" -}}
{{- $companyDevice := promptBoolOnce . "companyDevice" "Company device" false -}}

{{- $os := .chezmoi.os -}}
{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}


{{- $wsl := false -}}
{{-   $osid_extended := $osid -}}
{{-   $windowsUser := "" -}}
{{ if eq .chezmoi.os "linux" }}
{{   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{-   $wsl = true -}}
{{-   $osid_extended = printf "%s-%s-wsl2" .chezmoi.os .chezmoi.osRelease.id -}}
{{-   $windowsUser = output "powershell.exe" "-NoProfile" "-Command" "$env:USERNAME" | trim -}}
{{-   if not $windowsUser -}}
{{-     $windowsUser = output "cmd.exe" "/c" "echo %USERNAME%" | trim -}}
{{-   end -}}
{{   end }}
{{ end }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    companyDevice = {{ $companyDevice }}
    os = {{ $os | quote }}
    osid = {{ $osid | quote }}
    osidExtended = {{ $osid_extended | quote }}
    wsl = {{ $wsl | quote }}
    windowsUser = {{ $windowsUser | quote }}

# Install yay and the 1Password CLI before chezmoi renders any template that
# calls onepasswordRead. Exits immediately once both are present.
[hooks.read-source-state.pre]
    command = {{ joinPath .chezmoi.sourceDir ".install-pre-requisites.sh" | quote }}
