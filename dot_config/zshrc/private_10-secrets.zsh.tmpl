# -----------------------------------------------------
# Secrets — canonical OP_* names, then compatibility aliases
#
# Chezmoi + `op` fill the OP_* values. Everything else should
# read those names, or the aliases below.
# Unused OP_* keys stay empty so we can grep for what's live.
# -----------------------------------------------------

# Canonical (source of truth)
export OP_GITHUB_TOKEN={{ trimPrefix "SHA256:/" (onepasswordRead "op://Private/Github OS/fingerprint") | quote }}
export OP_GITHUB_USERNAME={{ onepasswordRead "op://Private/Github OS/username" | quote }}
export OP_NPM_TOKEN={{ onepasswordRead "op://Private/Github OS/npmAuthToken" | quote }}
export OP_GITHUB_PASSWORD="$OP_NPM_TOKEN"
export OP_NX_CACHE_SERVER="${OP_NX_CACHE_SERVER:-https://nx-cache.dev.huspy.net}"
export OP_NX_CACHE_TOKEN="${OP_NX_CACHE_TOKEN:-}"

# Compatibility aliases — original names used by tooling
export GITHUB_TOKEN="$OP_GITHUB_TOKEN"
export GIT_USERNAME="$OP_GITHUB_USERNAME"
export GITHUB_ACTOR="$OP_GITHUB_USERNAME"
export NPM_TOKEN="$OP_NPM_TOKEN"
export GIT_PASSWORD="$OP_GITHUB_PASSWORD"
export NX_SELF_HOSTED_REMOTE_CACHE_SERVER="$OP_NX_CACHE_SERVER"
export NX_SELF_HOSTED_REMOTE_CACHE_ACCESS_TOKEN="$OP_NX_CACHE_TOKEN"
