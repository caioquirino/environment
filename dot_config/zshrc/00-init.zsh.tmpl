{{- $osDifferences := .osDifferences -}}
{{- $osidExtended := .osidExtended -}}
{{- $os := .os -}}
{{- $pnpmHome := get (dig $osidExtended "pnpm_home" $osDifferences) "pnpm_home" -}}
{{- $androidSdkHome := get (dig $osidExtended "android_sdk_home_path" $osDifferences) "android_sdk_home_path" -}}
{{- $nvmScript := get (dig $osidExtended "nvm_script" $osDifferences) "nvm_script" -}}
# -----------------------------------------------------
# INIT — paths, editors, version-manager shims (cheap)
# Heavy inits (nvm/sdkman/pyenv) are deferred in 30-integrations.zsh
# -----------------------------------------------------

export EDITOR=nvim
export VISUAL=nvim
export COLORTERM=truecolor
export PAGER=less
export LESS=-R

export ZSH="$HOME/.oh-my-zsh"

typeset -gU path PATH
path=(
  "$HOME/.local/share/mise/shims"
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/go/bin"
  "{{ $pnpmHome }}"
{{- if eq $os "linux" }}
  /var/lib/snapd/snap/bin
{{- end }}
  /usr/local/sbin
  /usr/local/bin
  /usr/bin
  /bin
  $path
)

# Android SDK — binaries only, no extra init
export ANDROID_HOME="${ANDROID_HOME:-{{ $androidSdkHome }}}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
path+=(
  "$ANDROID_HOME/emulator"
  "$ANDROID_HOME/platform-tools"
  "$ANDROID_HOME/tools"
  "$ANDROID_HOME/tools/bin"
)

# pnpm
export PNPM_HOME="${PNPM_HOME:-{{ $pnpmHome }}}"

# Cheap SDKMAN binaries (java, mvn, …) without sourcing sdkman-init
export SDKMAN_DIR="${SDKMAN_DIR:-$HOME/.sdkman}"
if [[ -d $SDKMAN_DIR/candidates ]]; then
  for _sdk_c in $SDKMAN_DIR/candidates/*/current/bin(N); do
    path+=("$_sdk_c")
  done
  unset _sdk_c
fi

# Cheap nvm default node on PATH without sourcing nvm.sh
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
export NVM_SCRIPT="${NVM_SCRIPT:-{{ $nvmScript }}}"
if [[ -d $NVM_DIR/versions/node ]]; then
  _nvm_target=""
  if [[ -r $NVM_DIR/alias/default ]]; then
    _nvm_target=$(<"$NVM_DIR/alias/default")
    [[ -r $NVM_DIR/alias/$_nvm_target ]] && _nvm_target=$(<"$NVM_DIR/alias/$_nvm_target")
  fi
  if [[ -n $_nvm_target ]]; then
    if [[ -d $NVM_DIR/versions/node/v${_nvm_target#v}/bin ]]; then
      path=("$NVM_DIR/versions/node/v${_nvm_target#v}/bin" $path)
    else
      _nvm_matches=($NVM_DIR/versions/node/v${_nvm_target#v}*(N/))
      _nvm_dir=${${(n)_nvm_matches}[-1]}
      [[ -n $_nvm_dir && -d $_nvm_dir/bin ]] && path=("$_nvm_dir/bin" $path)
      unset _nvm_matches
    fi
  fi
  unset _nvm_target _nvm_dir
fi

# ROCm / Ollama (no-op if the prefix is absent)
if [[ -d /opt/rocm ]]; then
  export ROCM_PATH=/opt/rocm
  export HIP_PATH=/opt/rocm
  export LD_LIBRARY_PATH="/opt/rocm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  path=(/opt/rocm/bin $path)
  export HSA_OVERRIDE_GFX_VERSION="${HSA_OVERRIDE_GFX_VERSION:-11.5.0}"
  export GPU_MAX_HEAP_SIZE="${GPU_MAX_HEAP_SIZE:-90}"
  export GPU_MAX_ALLOC_PERCENT="${GPU_MAX_ALLOC_PERCENT:-90}"
fi

export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"

[[ -r $HOME/.zsh/utils.zsh ]] && source "$HOME/.zsh/utils.zsh"
