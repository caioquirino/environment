{{- $osDifferences := .osDifferences -}}
{{- $osidExtended := .osidExtended -}}
{{- $os := .os -}}
{{- $pnpmHome := get (dig $osidExtended "pnpm_home" $osDifferences) "pnpm_home" -}}
{{- $androidSdkHome := get (dig $osidExtended "android_sdk_home_path" $osDifferences) "android_sdk_home_path" -}}
# Shared env and PATH. Sourced by zsh and bash. No shell-specific syntax.

export EDITOR=nvim
export VISUAL=nvim
export COLORTERM=truecolor
export PAGER=less
export LESS=-R
{{- if eq .wsl "true" }}
# Open links/files with the Windows default app (wslu)
export BROWSER=wslview
{{- end }}

export PNPM_HOME="${PNPM_HOME:-{{ $pnpmHome }}}"
export ANDROID_HOME="${ANDROID_HOME:-{{ $androidSdkHome }}}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"

_shell_prepend_path() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

_shell_append_path() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$PATH:$1" ;;
  esac
}

# mise shims: tools resolve in non-interactive shells and IDEs too
_shell_prepend_path "$HOME/.local/share/mise/shims"
_shell_prepend_path "$HOME/.local/bin"
_shell_prepend_path "$HOME/.cargo/bin"
_shell_prepend_path "$HOME/go/bin"
_shell_prepend_path "$PNPM_HOME"
{{- if eq $os "linux" }}
_shell_append_path /var/lib/snapd/snap/bin
{{- end }}
_shell_append_path "$ANDROID_HOME/emulator"
_shell_append_path "$ANDROID_HOME/platform-tools"
_shell_append_path "$ANDROID_HOME/tools"
_shell_append_path "$ANDROID_HOME/tools/bin"

if [ -d /opt/rocm ]; then
  export ROCM_PATH=/opt/rocm
  export HIP_PATH=/opt/rocm
  export LD_LIBRARY_PATH="/opt/rocm/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  _shell_prepend_path /opt/rocm/bin
  export HSA_OVERRIDE_GFX_VERSION="${HSA_OVERRIDE_GFX_VERSION:-11.5.0}"
  export GPU_MAX_HEAP_SIZE="${GPU_MAX_HEAP_SIZE:-90}"
  export GPU_MAX_ALLOC_PERCENT="${GPU_MAX_ALLOC_PERCENT:-90}"
fi

unset -f _shell_prepend_path _shell_append_path
export PATH
