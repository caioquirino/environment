# (_)___|___/_| |_|_|  \___|
#
# Loader: source every file in ~/.config/zshrc, then ~/.config/zshrc/custom
# (directories are skipped). Stay at top-level so PATH is never local.

for _zshrc_f in ~/.config/zshrc/*(N.) ~/.config/zshrc/custom/*(N.); do
  source "$_zshrc_f"
done
unset _zshrc_f
{{ if .companyDevice }}
# huspy-cli-tools: lazy CodeArtifact auth for mvn/gradle
[[ -s "$HOME/.local/bin/codeartifact-lazy.sh" ]] && source "$HOME/.local/bin/codeartifact-lazy.sh"
{{ end -}}
